# Example .env for LifeLink backend
# Copy this to a file named .env in the same folder as package.json/server.js

# Use Razorpay TEST keys while developing
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Fast2SMS API for OTP sending (optional - for SMS delivery)
# Get free API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Other useful env vars
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/LifeLinkdb
